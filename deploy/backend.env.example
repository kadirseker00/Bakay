# Sunucuda /etc/bakay/backend.env olarak saklanır (root:root, izin 600).
# API anahtarını bu örnek dosyaya veya git'e yazmayın.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_THINKING=between_tools
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT=120
EMBEDDING_MODEL=sentence-transformers/LaBSE
CHROMA_DIR=./data/chroma
COLLECTION_NAME=ktmu_docs
TOP_K=5
SCORE_THRESHOLD=0.30
AGENT_ROUTE=false
AGENT_REWRITE=false
AGENT_VERIFY=false
LOG_DIR=./data/logs
DB_PATH=./data/bakay.db
HF_HOME=/var/lib/bakay/huggingface

# Ollama seçilecekse sağlayıcıyı ve sunucudaki modeli ayrıca doğrulayın.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024

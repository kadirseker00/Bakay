# Sunucuda /etc/bakay/backend.env olarak saklanır (root:root, izin 600).
# API anahtarını bu örnek dosyaya veya git'e yazmayın.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_THINKING=adaptive
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT=120
EMBEDDING_MODEL=sentence-transformers/LaBSE
CHROMA_DIR=./data/chroma
COLLECTION_NAME=ktmu_docs
TOP_K=5
SCORE_THRESHOLD=0.30
AGENT_ROUTE=false
AGENT_REWRITE=false
AGENT_VERIFY=false
LOG_DIR=./data/logs
DB_PATH=./data/bakay.db
HF_HOME=/var/lib/bakay/huggingface

# Panel: /monitor. Parola hash'i ve oturum sırrı gerçek kurulumda üretilir.
MONITOR_USERNAME=adminbakai
MONITOR_PASSWORD_HASH=
MONITOR_SESSION_SECRET=
MONITOR_PUBLIC_URL=https://bakai.manas.edu.kg
MONITOR_SHOW_QUERY_DETAILS=true

# Soru kotaları kayan zaman aralıklarıyla ölçülür; restart sonrası korunur.
RATE_CHAT_PER_MINUTE=30
RATE_CHAT_PER_HOUR=120
RATE_CHAT_GLOBAL_PER_MINUTE=30
RATE_CHAT_GLOBAL_PER_DAY=1000
RATE_CHAT_CONCURRENT=2
RATE_CHAT_CONCURRENT_PER_IP=2
RATE_MAX_BODY_BYTES=131072
RATE_BODY_TIMEOUT=10

# Ollama seçilecekse sağlayıcıyı ve sunucudaki modeli ayrıca doğrulayın.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024

# Alarm geçişleri panelde görünür; SMTP bağlanana kadar e-posta gönderilmez.
ALERT_DAILY_USD=1
ALERT_DISK_PERCENT=85
ALERT_MEMORY_PERCENT=90
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURITY=starttls
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
BACKUP_STATUS_PATH=/var/lib/bakay/backup-status.json

# Yalnız bakai.manas.edu.kg için Turnstile; özel anahtar yalnız sunucuda.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_HOSTNAME=bakai.manas.edu.kg

[Unit]
Description=BAKAI Next.js
After=network-online.target bakay-backend.service
Wants=network-online.target

[Service]
Type=simple
User=bakay
Group=bakay
WorkingDirectory=/opt/bakay/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_API_URL=/api değeri npm run build sırasında verilir.
ExecStart=/opt/bakay/runtime/node/bin/node /opt/bakay/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bakay/frontend/.next

[Install]
WantedBy=multi-user.target

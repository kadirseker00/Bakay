[Unit]
Description=BAKAI FastAPI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bakay
Group=bakay
WorkingDirectory=/opt/bakay/backend
EnvironmentFile=/etc/bakay/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/bakay/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bakay/data /var/lib/bakay

[Install]
WantedBy=multi-user.target
